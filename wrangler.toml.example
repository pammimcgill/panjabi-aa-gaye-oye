name = "punjabi-seattle"
main = "src/worker.js"
compatibility_date = "2026-08-01"

[[routes]]
pattern = "panjabiaagayeoye.com"
custom_domain = true

[[routes]]
pattern = "www.panjabiaagayeoye.com"
custom_domain = true

[assets]
directory = "./public"
binding = "ASSETS"

[[d1_databases]]
binding = "DB"
database_name = "punjabi-seattle-events-v2"
database_id = "73037eef-a4b7-4e70-8a5d-660d881b90f0"
migrations_dir = "migrations"

[triggers]
crons = ["17 */6 * * *"]

[vars]
SITE_ORIGIN = "https://panjabiaagayeoye.com"

# Add secrets with Wrangler; never put them in this file:
# npx wrangler secret put SEATGEEK_CLIENT_ID
# npx wrangler secret put ADMIN_KEY
